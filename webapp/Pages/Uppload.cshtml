@page
@model webapp.Pages.UpploadModel
@{
    ViewData["Title"] = "Upload Resume";
}

<h2>Upload Resume</h2>

<form method="post" enctype="multipart/form-data">
    <div>
        <label asp-for="Resume.File">Select your resume:</label>
        <input asp-for="Resume.File" type="file" />
        <span asp-validation-for="Resume.File" class="text-danger"></span>
    </div>

    <button type="submit">Upload</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
